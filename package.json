{
  "name": "markdown-editor",
  "version": "1.0.0",
  "description": "Typora 风格双栏 Markdown 编辑器（Electron + Vue 3）",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "vue3"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.1.4",
    "vue": "^3.5.13"
  }
}
